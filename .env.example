# Copy this file to .env and fill in the values. .env is gitignored.

# Django
SECRET_KEY=replace-me-generate-a-new-one
DEBUG=True

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx

# Email (Mailtrap or your SMTP provider)
EMAIL_HOST_PASSWORD=xxx

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=xxx

# Facebook OAuth
FACEBOOK_CLIENT_ID=xxx
FACEBOOK_APP_SECRET=xxx
