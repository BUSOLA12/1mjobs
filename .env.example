# Copy this file to .env and fill in the values. .env is gitignored.

# Django
SECRET_KEY=replace-me-generate-a-new-one
DEBUG=True

# African Money (africanmoney.net) collection API: the only payment gateway.
# api_key authenticates collection/create; secret_key authenticates verify (Bearer).
AFRICANMONEY_API_KEY=
AFRICANMONEY_SECRET_KEY=

# Email (Resend SMTP)
RESEND_API_KEY=re_xxx
# From address. Use onboarding@resend.dev until your domain is verified in Resend.
DEFAULT_FROM_EMAIL=One Million Jobs <onboarding@resend.dev>
# Set True locally to print emails to the console instead of sending via Resend.
EMAIL_USE_CONSOLE=False
# SMTP port: 465 (SSL) is the reliable default; use 587 only if your network allows it.
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=xxx

# Google Maps JavaScript API key
GOOGLE_MAPS_API_KEY=xxx

# Facebook OAuth
FACEBOOK_CLIENT_ID=xxx
FACEBOOK_APP_SECRET=xxx

# --- Production / deployment (e.g. Fly.io). Set as Fly secrets, not committed. ---
# Redis connection URL for Channels (Upstash on Fly). Empty = local 127.0.0.1:6379.
REDIS_URL=
# Public host for absolute links in emails (password reset). Defaults to the Fly host.
DOMAIN=one-million-jobs.fly.dev
# Extra hostnames to allow, comma-separated (the deploy domain).
EXTRA_ALLOWED_HOSTS=one-million-jobs.fly.dev
# Extra CSRF trusted origins, comma-separated full origins.
CSRF_EXTRA_ORIGINS=https://one-million-jobs.fly.dev
# Persistent paths on the Fly volume (set via fly.toml [env]).
SQLITE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media
